# ── Model ───────────────────────────────────────────────────────────────
# Default provider is Claude via the Claude Agent SDK.
# Set ANTHROPIC_API_KEY (https://console.anthropic.com). For local development
# the SDK can instead use an existing Claude Code login on the machine.
ANTHROPIC_API_KEY=
# Optional: claude (default) | gemini
LLM_PROVIDER=claude
# Optional: Claude model and reasoning effort (low | medium | high)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# Only needed when LLM_PROVIDER=gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# ── Web search (at least one required; both = automatic failover) ───────
# Discovery providers, tried in order. We fetch, read and rank the pages ourselves.
# Tavily — free 1,000 credits/month — https://tavily.com
TAVILY_API_KEY=
# Firecrawl — free 1,000 credits/month — https://firecrawl.dev
# Also renders JavaScript-heavy pages (e.g. pricing tables) when our reader can't.
FIRECRAWL_API_KEY=

# ── Storage (optional) ──────────────────────────────────────────────────
DB_PATH=data/agent.db
