# ── Model ───────────────────────────────────────────────────────────────
# Claude, via the Claude Agent SDK (primary — this project was built without
# an API key). It uses ANTHROPIC_API_KEY if set, otherwise the Claude Code
# login on this machine. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: CLAUDE_RUNTIME=api runs our own agent loop on the Messages API
# instead (needs ANTHROPIC_API_KEY; adds prompt caching and refusal fallback).
CLAUDE_RUNTIME=
# Optional: answering model and its reasoning effort (low | medium | high)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
# Optional: small model used in the background to distil memory
CLAUDE_MEMORY_MODEL=claude-haiku-5-5

# ── Web search (at least one required; both = automatic failover) ───────
# Discovery providers, tried in order. We fetch, read and rank the pages ourselves.
# Tavily — free 1,000 credits/month — https://tavily.com
TAVILY_API_KEY=
# Firecrawl — free 1,000 credits/month — https://firecrawl.dev
# Also renders JavaScript-heavy pages (e.g. pricing tables) when our reader can't.
FIRECRAWL_API_KEY=

# ── Storage (optional) ──────────────────────────────────────────────────
DB_PATH=data/agent.db
